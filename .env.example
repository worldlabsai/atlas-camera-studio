# Local use: keep your beta API key on the server. No Clerk/Stripe account required.
APP_MODE=local
WLT_API_KEY=
WLT_API_BASE_URL=https://api.atlas-beta.worldlabs.ai/api/v2
PORT=3030
DATA_DIR=./data

